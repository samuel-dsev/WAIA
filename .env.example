PORT=3000
API_DOMAIN=api.suaplataforma.com
PANEL_DOMAIN=painel.suaplataforma.com
POSTGRES_DB=waia
POSTGRES_USER=waia_owner
POSTGRES_PASSWORD=
DATABASE_APP_USER=waia_app
DATABASE_APP_PASSWORD=
# Usada apenas por scripts de migracao fora do Compose. API e worker nunca recebem esta URL.
DATABASE_MIGRATOR_URL=
BACKUP_RETENTION_DAYS=7
WAIA_COMPOSE_PROJECT=waia-test
# Referencia nao secreta da copia externa, por exemplo: vault://waia/keyring/2026-09
KEYRING_CUSTODY_REFERENCE=
WEBHOOK_PORT=3001
INFRASTRUCTURE_MODE=postgres
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=
REDIS_QUEUE_NAME=waia-messages
WORKER_CONCURRENCY=4
TENANT_CONCURRENCY=1
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=500
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_TTL_MS=30000
GOOGLE_SHEETS_SYNC_INTERVAL_MS=120000
MEDIA_STORAGE_ROOT=C:\waia-data\media
MEDIA_MAX_BYTES=10485760
SESSION_PEPPER=
MASTER_KEYRING=
METRICS_BEARER_TOKEN=
COOKIE_SECURE=
PANEL_ORIGIN=http://localhost:3000
# Planilha e JSON da conta de serviço do runtime SaaS são configurados no painel e guardados por empresa.
# As variáveis GOOGLE_* abaixo existem somente para src/server.js (legado).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=.secrets/google-service-account.json

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_MAX_OUTPUT_TOKENS=300
# JSON versionado; permite revisar precos sem rebuild. Nunca inclua chaves.
OPENAI_PRICING_CATALOG=

# Gate de piloto: rede/VPN administrativa e paginas legais revisadas.
ADMIN_NETWORK_ALLOWLIST=
LEGAL_PLATFORM_NAME=
LEGAL_PRIVACY_EMAIL=
LEGAL_CONTROLLER_NOTICE=

# Monitor operacional opcional no waia-test e obrigatorio antes do piloto.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_AUTHORIZATION=
ALERT_WEBHOOK_FORMAT=generic
ALERT_TIMEOUT_MS=10000
ALERT_MONITOR_INTERVAL_MS=60000
ALERT_QUEUE_WAITING_THRESHOLD=100

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
META_APP_SECRET=

# Contas publicas: rollout desligado; configurar uma vez por plataforma, nao por tenant.
CUSTOMER_ACCOUNTS_ENABLED=false
CUSTOMER_PORTAL_ORIGIN=http://localhost:3001
CUSTOMER_COMPANY_LIMIT=1
CUSTOMER_SESSION_MS=43200000
CUSTOMER_IDLE_MS=3600000
CUSTOMER_VERIFY_MS=86400000
CUSTOMER_RESET_MS=1800000
ACCOUNT_EMAIL_MODE=disabled
ACCOUNT_EMAIL_ENDPOINT=
ACCOUNT_EMAIL_TOKEN=
ACCOUNT_EMAIL_FROM=
# Lista de IPs/CIDRs dos proxies confiaveis. Vazio = conexao direta.
TRUST_PROXY=

# Somente para a entrada legada src/server.js. O runtime SaaS usa o cofre por empresa.
CAPITAO_MOR_WHATSAPP_ACCESS_TOKEN=
CAPITAO_MOR_WHATSAPP_PHONE_NUMBER_ID=
