POSTGRES_PASSWORD=
DATABASE_APP_USER=waia_app
DATABASE_APP_PASSWORD=
# Usada apenas por scripts de migracao fora do Compose. API e worker nunca recebem esta URL.
DATABASE_MIGRATOR_URL=
BACKUP_RETENTION_DAYS=7
WEBHOOK_PORT=3001
INFRASTRUCTURE_MODE=postgres
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=
REDIS_QUEUE_NAME=waia-messages
WORKER_CONCURRENCY=4
TENANT_CONCURRENCY=1
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=500
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_TTL_MS=30000
SESSION_PEPPER=
MASTER_KEYRING=
COOKIE_SECURE=
PANEL_ORIGIN=http://localhost:3000
GOOGLE_SHEETS_SPREADSHEET_ID=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=300

WHATSAPP_VERIFY_TOKEN=
