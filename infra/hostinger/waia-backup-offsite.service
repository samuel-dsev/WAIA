[Unit]
Description=Copia cifrada externa do backup WAIA
Requires=network-online.target
After=network-online.target waia-backup.service

[Service]
Type=oneshot
WorkingDirectory=/opt/waia/current
Environment=BACKUP_DIR=/opt/waia/backups
Environment=RCLONE_CONFIG=/etc/waia/rclone.conf
EnvironmentFile=/etc/waia/offsite-backup.env
UMask=0077
ExecStart=/bin/sh /usr/local/libexec/waia/backup-offsite.sh

[Install]
WantedBy=multi-user.target
